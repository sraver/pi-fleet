# Copy to .env and adjust. Read by docker compose at /opt/media-center/.env
# The image ships a working .env; edit it on the Pi if you need to change anything.

# Must match the user created by ezsdm.sh (uid/gid of "sha")
PUID=1000
PGID=1000

TZ=Europe/Madrid

# Mount point of the external SSD. Everything lives under here:
# appdata/ (container configs + databases), downloads/, media/
DATA_ROOT=/mnt/data

# Web UI ports
PROWLARR_PORT=9696
SONARR_PORT=8989
RADARR_PORT=7878
QBITTORRENT_PORT=8080
JELLYFIN_PORT=8096

# qBittorrent listening port for peers (forward this one on the router if you
# want incoming connections; it is NOT a web UI)
QBITTORRENT_PEER_PORT=6881
